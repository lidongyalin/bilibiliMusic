# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

outputs
uploads
node_modules
dist
.qa
.tmp
.zcode
.workbuddy
.probe
dist-ssr
# 构建前备份的旧产物（npm run build 会留一份），22MB 纯生成物
dist-old*/
# electron-builder 打包输出（安装包 + 未压缩的 app 目录，几百 MB）
release/
*.local

# 环境变量文件：含数据库密码、JWT 密钥、SMTP 授权码等真实凭证，严禁入库。
# 需要模板请提交 .env.example（只写变量名与占位值，不写真实值）。
.env
.env.*
!.env.example

# SQLite 数据库与用户上传文件（含凭证与用户数据，严禁入库）
data/*.db
data/*.db-shm
data/*.db-wal
data/uploads/

# 收藏列表与歌单是运行时生成的用户数据，不入库
data/favorites.json
data/playlists.json

# 本地调试残留与运行时缓存：含调试脚本里的伪造 JWT，严禁入库
server.err
*.err
server/.smoke*.mjs
write_app.cjs
src/util/.image-cache.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 后端运行日志（开发时重定向输出）
*.out
